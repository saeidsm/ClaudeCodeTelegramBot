# Canonical report-retention cleanup (repository-owned).
# Replaces the three conflicting cron jobs — see docs/REPORT_RETENTION_MIGRATION.md.
# Install: copy to /etc/systemd/system/, `systemctl daemon-reload`,
#          `systemctl enable --now reports-cleanup.timer`.
[Unit]
Description=Shahrzad bot report retention cleanup (canonical, 15-day TTL)
Documentation=file:///opt/shahrzad-devops/repos/ClaudeCodeTelegramBot/docs/REPORT_RETENTION_MIGRATION.md
After=network.target

[Service]
Type=oneshot
# The script reads the report path token from BOT_CONFIGS_DIR/reports-token.env.
# Load only the bot's env file (for BOT_DATA_ROOT / BOT_REPORTS / BOT_CONFIGS_DIR /
# BOT_REPORT_RETENTION_DAYS overrides). EnvironmentFile is optional (leading '-').
EnvironmentFile=-/opt/shahrzad-devops/.env
ExecStart=/opt/shahrzad-devops/repos/ClaudeCodeTelegramBot/scripts/cleanup-reports.sh

# Defensive hardening that still allows writing under the reports tree.
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# Reports live here — must remain writable for the cleanup to remove expired dirs.
ReadWritePaths=/opt/shahrzad-devops/reports

[Install]
WantedBy=multi-user.target
