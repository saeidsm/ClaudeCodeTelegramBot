# ── Required ──
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_CHAT_ID=123456789              # Comma-separated authorized chat IDs

# ── Gemini (voice transcription + fallback) ──
GEMINI_API_KEY=your-gemini-api-key

# ── Optional: Fallback AI providers ──
OPENAI_API_KEY=                         # For GPT-4o fallback
OPENROUTER_API_KEY=                     # Fallback chain AND Phase 2 Chat engine

# ─── Phase 2: multi-engine (Claude Code | Codex | Chat) ───────────────
# Codex CLI (must be `codex login`-ed on the server as the bot user):
# BOT_CODEX_DEFAULT_MODEL=gpt-5.6-sol       # Sol=gpt-5.6-sol Terra=..terra Luna=..luna
# BOT_CODEX_MODELS=gpt-5.6-sol:Sol,gpt-5.6-terra:Terra   # override discovered catalog
# BOT_CODEX_SANDBOX=                          # read-only|workspace-write|danger-full-access
#                                             # (default: maps from BOT_TOOL_PERMISSION_MODE)
# Claude catalog override (id:Label,...); default = verified Fable5/Opus4.8/Sonnet5/Haiku4.5
# BOT_CLAUDE_MODELS=
# OpenRouter Chat engine:
# BOT_CHAT_SESSIONS_DIR=/opt/shahrzad-devops/chat-sessions   # bounded per-session history
# BOT_COORDINATION_FILE=/opt/shahrzad-devops/configs/coordination.json  # shared agent store
# BOT_CHAT_CATALOG_CACHE=/opt/shahrzad-devops/configs/openrouter-catalog.json  # OpenRouter catalog cache (default: ${BOT_CONFIGS_DIR}/openrouter-catalog.json)
# BOT_CHAT_CATALOG_TTL=3600                   # seconds; last-known-good persists across restarts
# BOT_CHAT_CONCURRENCY=4                       # independent of BOT_MAX_RUNNING_AGENTS (heavy cap)
# BOT_CHAT_HISTORY_MAX_TURNS=20                # bounded conversation memory per chat session
# BOT_CHAT_HISTORY_MAX_CHARS=40000
# 10 owner-configured favorites (provider ids, NOT a popularity ranking). Default includes
# z-ai/glm-5.2, minimax/minimax-m3, qwen/qwen3.7-max + 7 strong alternatives.
# BOT_CHAT_FAVORITES=z-ai/glm-5.2,minimax/minimax-m3,qwen/qwen3.7-max,anthropic/claude-opus-4.8,...

# ── Optional: Production server (for health/logs/deploy buttons) ──
PROD_SERVER_IP=                         # e.g. 192.168.1.100
PROD_SERVER_USER=root                   # SSH user for production
PROD_HOST=127.0.0.1                     # Host the /logs button SSHs into (passed to scripts/collect-logs.sh)

# ── Optional: Public-facing URLs ──
REPORTS_BASE_URL=http://localhost:8080/reports   # Where the "Full Report" buttons point
APP_REFERER_URL=http://localhost                 # HTTP-Referer sent with OpenRouter requests
APP_TITLE=Claude Code Telegram Bot               # X-Title sent with OpenRouter requests (free-form)

# ── Optional: Paths (defaults to bot.py directory) ──
# BOT_BASE_DIR=/opt/mybot
# BOT_REPOS_DIR=/opt/mybot/repos
# BOT_REPORTS_DIR=/opt/mybot/reports
# BOT_LOGS_DIR=/opt/mybot/logs
# BOT_SCRIPTS_DIR=/opt/mybot/scripts
# BOT_UPLOADS_DIR=/opt/mybot/uploads
# BOT_PROMPTS_FILE=/opt/mybot/configs/gemini-prompts.json
# BOT_PROJECTS_FILE=/opt/mybot/configs/projects.json
# BOT_USAGE_DB=/opt/mybot/configs/usage_tracker.json

# ── Optional: Bot behavior ──
# BOT_REPORT_URL=https://your-server.com/reports
# BOT_DEFAULT_PROJECT=MyProject
# BOT_PERMANENT_PROJECTS=ProjectA,ProjectB   # Never auto-close these sessions
# Two DISTINCT limits (do not conflate):
#   BOT_MAX_SESSIONS       = logical/restorable sessions per chat (cheap)
#   BOT_MAX_RUNNING_AGENTS = simultaneous heavy Claude executions bot-wide (RAM/CPU)
# 9 sessions can exist; only 2 execute at once (the rest show "queued").
# Invalid/non-positive values fall back to the safe defaults (4 / 2).
BOT_MAX_SESSIONS=9
BOT_MAX_RUNNING_AGENTS=2
# BOT_SESSION_TIMEOUT_HOURS=72
# BOT_PAUSE_SECONDS=5
# Report retention (days) enforced by scripts/cleanup-reports.sh. Default 15.
# BOT_REPORT_RETENTION_DAYS=15

# ── Optional: Token limits ──
# BOT_HOURLY_TOKEN_LIMIT=100000
# BOT_DAILY_TOKEN_LIMIT=1000000
# BOT_WEEKLY_TOKEN_LIMIT=5000000

# ── Optional: GPT fallback model ──
# BOT_GPT_FALLBACK_MODEL=gpt-4o

# ── NightWatch IPC (Phase 2A) ──
BOT_NIGHTWATCH_HMAC_SECRET=                # 32+ random hex chars; if unset, IPC server is skipped
BOT_NIGHTWATCH_IPC_PORT=9091
BOT_NIGHTWATCH_IPC_BIND=127.0.0.1
# Optional SECOND listener bind. EMPTY by default. Set to a loopback/private IP
# (e.g. the DO VPC private IP 10.108.0.4) so another host on the VPC can POST
# /inject while 127.0.0.1 stays bound for local scripts. Wildcard (0.0.0.0/::),
# public, multicast, or invalid addresses are rejected and only the primary binds.
BOT_NIGHTWATCH_IPC_BIND2=
BOT_NIGHTWATCH_ALLOWED_FILE_PREFIXES=/var/lib/nightwatch/snapshots/  # Adjust to wherever the external NightWatch service writes

# ─── Video / Remotion pipeline ───────────────────────────────────────
# Remotion project root (must contain package.json + src/Root.tsx)
REMOTION_PROJECT_DIR=/mnt/devopsstorage/repos/video
# Brand & music assets root (per-brand subfolders + _shared/{fonts,music})
REMOTION_ASSETS_DIR=/tmp/remotion-assets
# ElevenLabs API key for Persian narration (eleven_multilingual_v2)
# Get from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
